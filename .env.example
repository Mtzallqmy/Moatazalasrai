# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NEXT_TELEMETRY_DISABLED="1"

# PostgreSQL / Neon
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with: openssl rand -base64 32
# Never commit the real value. Rotation requires re-encrypting stored provider credentials.
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# One-time bootstrap protection. Generate with: openssl rand -hex 32
# Rotate or remove it after the first organization has been created.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"

# Optional one-time owner bootstrap.
# Set these only in Railway, call POST /api/v1/bootstrap-owner with the bootstrap token,
# then remove OWNER_INITIAL_PASSWORD and rotate BOOTSTRAP_ADMIN_TOKEN immediately.
OWNER_NAME="معتز العلقمي"
OWNER_EMAIL="owner@example.com"
OWNER_INITIAL_PASSWORD="replace-with-a-strong-temporary-password"
OWNER_ORGANIZATION_NAME="Moataz Agent Platform"

# Optional observability
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Optional isolated integration / E2E environment
TEST_DATABASE_URL=""
E2E_BASE_URL=""
E2E_PROVIDER_KIND=""
E2E_PROVIDER_KEY=""
E2E_PROVIDER_BASE_URL=""
E2E_PROVIDER_MODEL=""

# Optional migration statement timeout for Railway pre-deploy (milliseconds, minimum 5000)
MIGRATION_TIMEOUT_MS="45000"
