# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NEXT_TELEMETRY_DISABLED="1"
APP_VERSION="dev"

# Trusted proxy headers. Enable Cloudflare only after the Railway origin is no longer publicly bypassable.
TRUST_CLOUDFLARE_PROXY="false"
TRUST_PROXY_HEADERS="false"

# Cloudflare Turnstile. Disabled locally by default; the secret is server-only.
TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_EXPECTED_HOSTNAME=""

# Attachment storage. Use local only for development/single-instance testing.
OBJECT_STORAGE_DRIVER="local"
ATTACHMENT_LOCAL_DIRECTORY=".data/attachments"
MAX_ATTACHMENT_BYTES="10485760"
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_SIGNED_URL_TTL_SECONDS="300"

# PostgreSQL. In Railway use a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"
CREDENTIAL_ENCRYPTION_KEY_ID="primary"
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS="{}"
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"
OWNER_NAME="معتز العلقمي"
OWNER_EMAIL="owner@example.com"
OWNER_INITIAL_PASSWORD="replace-with-a-strong-temporary-password"
OWNER_ORGANIZATION_NAME="Moataz Agent Platform"

MAX_MODEL_STEPS_PER_RUN="8"
MAX_TOTAL_TOOL_CALLS_PER_RUN="12"
TOOL_APPROVAL_TTL_SECONDS="900"
RUN_CHECKPOINT_TTL_SECONDS="86400"
AI_WORKER_ENABLED="true"
WORKER_CONCURRENCY="4"
AI_OTEL_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
AI_MEMORY_ENABLED="false"
AI_RAG_ENABLED="false"
AI_WORKFLOWS_ENABLED="false"
AI_TOOLS_ENABLED="true"
AI_EXTERNAL_LLM_GATEWAY_ENABLED="false"
EXTERNAL_LLM_GATEWAY_BASE_URL=""
EXTERNAL_LLM_GATEWAY_API_KEY=""

BROWSER_AGENT_ENABLED="false"
GOOGLE_OAUTH_INTEGRATIONS_ENABLED="false"
BROWSER_INTERACTIVE_LOGIN_ENABLED="false"
BROWSER_SCREENSHOTS_ENABLED="false"
BROWSER_RUNNER_URL=""
BROWSER_RUNNER_SHARED_SECRET=""
BROWSER_WORKER_CONCURRENCY="1"
BROWSER_TASK_TIMEOUT_MS="300000"
BROWSER_MAX_STEPS="50"
BROWSER_MAX_PAGES="5"
BROWSER_ALLOWED_DOWNLOAD_BYTES="10485760"
BROWSER_ARTIFACT_RETENTION_DAYS="7"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/site-connections/oauth/callback"

SANDBOX_ENABLED="false"
SANDBOX_RUNNER_URL=""
SANDBOX_RUNNER_SHARED_SECRET=""
SANDBOX_EXECUTION_TIMEOUT_MS="300000"
SANDBOX_MAX_OUTPUT_BYTES="2097152"
SANDBOX_MAX_FILE_BYTES="10485760"
SANDBOX_WORKSPACE_DISK_BYTES="536870912"
SANDBOX_MAX_CONCURRENT_PER_ORG="2"
SANDBOX_ARTIFACT_RETENTION_DAYS="7"

# Execution Kernel Foundation. Disabled until a separate isolated Runner service is deployed.
EXECUTION_KERNEL_ENABLED="false"
EXECUTION_RUNNER="existing"
EXECUTION_DEFAULT_TIMEOUT_MS="300000"
EXECUTION_DEFAULT_MEMORY_BYTES="536870912"
EXECUTION_DEFAULT_DISK_BYTES="1073741824"
EXECUTION_DEFAULT_MAX_PROCESSES="64"
EXECUTION_DEFAULT_MAX_OUTPUT_BYTES="5242880"
EXECUTION_DEFAULT_MAX_ARTIFACT_BYTES="104857600"
EXECUTION_DEFAULT_NETWORK_MODE="deny_all"
EXECUTION_WORKSPACE_TTL_SECONDS="1800"
EXECUTION_HEARTBEAT_INTERVAL_SECONDS="15"
EXECUTION_LEASE_TTL_SECONDS="60"
EXECUTION_RECONCILE_INTERVAL_SECONDS="60"
EXECUTION_RECONCILE_GRACE_SECONDS="120"
EXECUTION_ARTIFACT_RETENTION_DAYS="7"

# Optional adapters. Keys are required only when the matching adapter is explicitly enabled.
EXECUTION_E2B_ENABLED="false"
E2B_API_KEY=""
EXECUTION_DAYTONA_ENABLED="false"
DAYTONA_API_KEY=""
EXECUTION_GVISOR_ENABLED="false"
EXECUTION_GVISOR_RUNTIME="runsc"

# Credential grants store hashes only. The proxy secret is required only when the kernel is enabled.
EXECUTION_CREDENTIAL_BROKER_ENABLED="true"
EXECUTION_CREDENTIAL_GRANT_TTL_SECONDS="300"
EXECUTION_PROXY_SHARED_SECRET=""

# Phase 2 Operational AI Tools. All are fail-closed until their real runtime is healthy.
TOOLS_RUNTIME_ENABLED="false"
DATA_INTERPRETER_ENABLED="false"
DATA_INTERPRETER_TEMPLATE_ID="python-data-v1"
DATA_INTERPRETER_MAX_REPAIR_ATTEMPTS="3"
DATA_INTERPRETER_MAX_DATASET_BYTES="104857600"
DATA_INTERPRETER_MAX_ROWS_PREVIEW="100"
CODING_AGENT_ENABLED="false"
CODING_AGENT_ENGINE="internal"
CODING_AGENT_TEMPLATE_ID="coding-node-python-v1"
CODING_AGENT_MAX_STEPS="40"
CODING_AGENT_MAX_REPAIR_ATTEMPTS="5"
CODING_AGENT_ALLOW_PULL_REQUESTS="false"
OPENHANDS_AGENT_ENABLED="false"
AIDER_AGENT_ENABLED="false"
BROWSER_AGENT_ENGINE="playwright"
BROWSER_AGENT_ALLOW_STAGEHAND="false"
BROWSER_AGENT_MAX_STEPS="50"
BROWSER_AGENT_SESSION_TTL_SECONDS="1800"
BROWSER_AGENT_TRACE_ENABLED="true"
VOICE_STUDIO_ENABLED="false"
VOICE_PREVIEW_MAX_CHARACTERS="500"
VOICE_FINAL_MAX_CHARACTERS="50000"
VOICE_MAX_CHUNKS="100"
VOICE_FFMPEG_ENABLED="true"
OPENAI_VOICE_PROVIDER_ENABLED="false"
ELEVENLABS_VOICE_PROVIDER_ENABLED="false"

CLOUDFLARE_AI_GATEWAY_ENABLED="false"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_GATEWAY_ID="default"
CLOUDFLARE_AI_GATEWAY_TOKEN=""
CLOUDFLARE_API_TOKEN=""
AI_PROVIDER_FALLBACK_ENABLED="false"
AI_PROVIDER_DIRECT_FALLBACK_ENABLED="false"
CLOUDFLARE_AI_LIVE_TEST="false"
CLOUDFLARE_AI_LIVE_MODEL=""

TEST_DATABASE_URL=""
E2E_BASE_URL=""
E2E_PROVIDER_KIND=""
E2E_PROVIDER_KEY=""
E2E_PROVIDER_BASE_URL=""
E2E_PROVIDER_MODEL=""
MIGRATION_TIMEOUT_MS="45000"
YOUTUBE_TRANSCRIPT_API_URL=""
YOUTUBE_TRANSCRIPT_API_KEY=""
NEXT_PUBLIC_PUTER_ENABLED="false"
NEXT_PUBLIC_PUTER_E2E_MOCK="false"

# Central Telegram bot. Generate both secrets independently; never expose them to the browser.
TELEGRAM_INTEGRATION_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
# Optional. Defaults to ${PUBLIC_APP_URL || APP_URL}/api/webhooks/telegram.
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_LINK_CODE_SECRET=""
TELEGRAM_LINK_CODE_TTL_MINUTES="10"
TELEGRAM_LINK_CODE_MAX_ATTEMPTS="5"
TELEGRAM_LINK_CODE_LENGTH="6"
# Migration escape hatch only. Keep false in production.
TELEGRAM_ALLOW_USER_BOT_TOKENS="false"
TELEGRAM_UPDATE_MODE="webhook"
TELEGRAM_WEBHOOK_MAX_BYTES="1048576"

# WhatsApp Business Platform (official Meta Cloud API only).
WHATSAPP_INTEGRATION_ENABLED=""
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_DISPLAY_PHONE_NUMBER=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_CONNECT_TOKEN_SECRET=""
WHATSAPP_CONNECT_TOKEN_TTL_MINUTES=""
