# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NEXT_TELEMETRY_DISABLED="1"
APP_VERSION="dev"

# Trusted proxy headers. Enable Cloudflare only after the Railway origin is no longer publicly bypassable.
TRUST_CLOUDFLARE_PROXY="false"
TRUST_PROXY_HEADERS="false"

# Cloudflare Turnstile. Disabled locally by default; the secret is server-only.
TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_EXPECTED_HOSTNAME=""

# Attachment storage. Use local only for development/single-instance testing.
OBJECT_STORAGE_DRIVER="local"
ATTACHMENT_LOCAL_DIRECTORY=".data/attachments"
MAX_ATTACHMENT_BYTES="10485760"
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_SIGNED_URL_TTL_SECONDS="300"

# PostgreSQL. In Railway use a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with: openssl rand -base64 32
# Never commit the real value. Web and Worker must use the same key.
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Stable identifier for the active key. Change it whenever the key changes.
CREDENTIAL_ENCRYPTION_KEY_ID="primary"
# JSON map of retired key IDs to base64 keys, used only during a controlled rotation.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS="{}"

# One-time bootstrap protection. Generate with: openssl rand -hex 32
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"

# Optional one-time owner bootstrap. Remove the temporary password after use.
OWNER_NAME="معتز العلقمي"
OWNER_EMAIL="owner@example.com"
OWNER_INITIAL_PASSWORD="replace-with-a-strong-temporary-password"
OWNER_ORGANIZATION_NAME="Moataz Agent Platform"

# AI SDK runtime safety limits. Values are clamped again inside the server.
MAX_MODEL_STEPS_PER_RUN="8"
MAX_TOTAL_TOOL_CALLS_PER_RUN="12"
TOOL_APPROVAL_TTL_SECONDS="900"
RUN_CHECKPOINT_TTL_SECONDS="86400"

# Graphile Worker. Configure this on the dedicated Worker service.
AI_WORKER_ENABLED="true"
WORKER_CONCURRENCY="4"

# OpenTelemetry. Inputs, outputs, prompts and tool payloads are never recorded.
AI_OTEL_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# Optional feature areas. Keep disabled until the corresponding backend is deployed.
AI_MEMORY_ENABLED="false"
AI_RAG_ENABLED="false"
AI_WORKFLOWS_ENABLED="false"
AI_TOOLS_ENABLED="true"
AI_EXTERNAL_LLM_GATEWAY_ENABLED="false"
EXTERNAL_LLM_GATEWAY_BASE_URL=""
EXTERNAL_LLM_GATEWAY_API_KEY=""

# Optional Cloudflare AI Gateway. OpenAI BYOK remains encrypted in PostgreSQL and
# is sent as the normal Authorization header; Anthropic and Gemini remain direct.
CLOUDFLARE_AI_GATEWAY_ENABLED="false"
CLOUDFLARE_ACCOUNT_ID="3daab68819d22a2285e860c07837884f"
CLOUDFLARE_AI_GATEWAY_ID="moataz-ai"
OPENAI_BASE_URL="https://gateway.ai.cloudflare.com/v1/3daab68819d22a2285e860c07837884f/moataz-ai/compat"
# Optional only when Authenticated Gateway is enabled in Cloudflare.
CLOUDFLARE_API_TOKEN=""

# Optional isolated integration / E2E environment
TEST_DATABASE_URL=""
E2E_BASE_URL=""
E2E_PROVIDER_KIND=""
E2E_PROVIDER_KEY=""
E2E_PROVIDER_BASE_URL=""
E2E_PROVIDER_MODEL=""

# Optional migration statement timeout for Railway pre-deploy (milliseconds, minimum 5000)
MIGRATION_TIMEOUT_MS="45000"

# Optional YouTube transcript adapter.
# Contract: HTTPS POST {"url":"https://youtube.com/..."} -> {"transcript":"..."}.
# For arbitrary providers, place a small adapter or MCP server in front of their API.
YOUTUBE_TRANSCRIPT_API_URL=""
YOUTUBE_TRANSCRIPT_API_KEY=""
