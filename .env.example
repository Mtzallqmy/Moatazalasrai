# PostgreSQL / Neon connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with: openssl rand -base64 32
# Never commit the real value. Rotating it requires re-encrypting provider credentials.
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# One-time bootstrap protection. Use a long random value and remove/rotate it after setup.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"

NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"
