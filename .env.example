# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NEXT_TELEMETRY_DISABLED="1"

# PostgreSQL. In Railway use a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with: openssl rand -base64 32
# Never commit the real value. Rotation requires re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# One-time bootstrap protection. Generate with: openssl rand -hex 32
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"

# Optional one-time owner bootstrap. Remove the temporary password after use.
OWNER_NAME="معتز العلقمي"
OWNER_EMAIL="owner@example.com"
OWNER_INITIAL_PASSWORD="replace-with-a-strong-temporary-password"
OWNER_ORGANIZATION_NAME="Moataz Agent Platform"

# Optional observability exporters; conversation content is not exported by default.
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Optional isolated integration / E2E environment
TEST_DATABASE_URL=""
E2E_BASE_URL=""
E2E_PROVIDER_KIND=""
E2E_PROVIDER_KEY=""
E2E_PROVIDER_BASE_URL=""
E2E_PROVIDER_MODEL=""

# Optional migration statement timeout for Railway pre-deploy (milliseconds, minimum 5000)
MIGRATION_TIMEOUT_MS="45000"

# Agent platform expansion. Enable incrementally after migration and verification.
AI_MEMORY_ENABLED="false"
AI_RAG_ENABLED="false"
AI_WORKFLOWS_ENABLED="false"
AI_TOOLS_ENABLED="false"
AI_WORKER_ENABLED="false"
AI_OTEL_ENABLED="false"
AI_EXTERNAL_LLM_GATEWAY_ENABLED="false"
JOB_POLL_INTERVAL_MS="2000"
JOB_LOCK_TIMEOUT_MS="300000"
JOB_MAX_ATTEMPTS="5"
JOB_BATCH_SIZE="5"
OTEL_EXPORTER_OTLP_HEADERS=""
EXTERNAL_LLM_GATEWAY_BASE_URL=""
EXTERNAL_LLM_GATEWAY_API_KEY=""

# Optional YouTube transcript adapter.
# Contract: HTTPS POST {"url":"https://youtube.com/..."} -> {"transcript":"..."}.
# For arbitrary providers, place a small adapter or MCP server in front of their API.
YOUTUBE_TRANSCRIPT_API_URL=""
YOUTUBE_TRANSCRIPT_API_KEY=""
