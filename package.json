  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.5.17",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "vitest": "^3.2.7",
    "eslint": "^9.0.0",
