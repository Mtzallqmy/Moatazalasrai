{
  "name": "moataz-agent-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Production-oriented multi-tenant AI agent platform with encrypted BYOK credentials and multi-provider model routing.",
  "license": "MIT",
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/integration",
    "execution:kernel:check": "node scripts/check-execution-kernel-readiness.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "worker:migrate": "node scripts/migrate-worker.mjs",
    "db:migrate:all": "npm run db:migrate && npm run worker:migrate",
    "db:studio": "drizzle-kit studio",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "worker": "node --import tsx src/worker/index.ts",
    "worker:dev": "node --import tsx --watch src/worker/index.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "telegram:webhook:setup": "node scripts/setup-telegram-webhook.mjs",
    "secrets:reencrypt": "node --import tsx scripts/reencrypt-secrets.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.16",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@fontsource-variable/alexandria": "5.3.0",
    "@heyputer/puter.js": "2.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "ai": "^7.0.40",
    "ajv": "8.20.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "graphile-worker": "^0.17.3",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "5.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "js-yaml": "4.3.1",
    "nanoid": "5.1.16",
    "postcss": "8.5.25",
    "sharp": "^0.35.0",
    "undici": "7.29.0",
    "ws": "8.21.1"
  }
}
